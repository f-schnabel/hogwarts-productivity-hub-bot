{
  "name": "hogwarts-productivity-hub-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "analytics:dev": "tsx watch src/analytics-dev.ts",
    "register": "tsx src/register-commands.ts",
    "format": "eslint . --fix",
    "test": "vitest",
    "test:arch": "vitest tests/architecture.test.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "validate": "npm run lint && npm run typecheck"
  },
  "keywords": [
    "discord",
    "bot",
    "productivity",
    "hogwarts",
    "voice-tracking"
  ],
  "author": "Felix Schnabel",
  "license": "ISC",
  "description": "Discord bot for Hogwarts-themed productivity community with voice tracking, house points, and year progression",
  "dependencies": {
    "@openrouter/sdk": "^1.2.119",
    "@vvo/tzdb": "^6.198.0",
    "common-tags": "^1.8.2",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "@prometheus-io/client": "^0.16.1",
    "twig": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/common-tags": "^1.8.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/twig": "^1.12.17",
    "@vitest/coverage-v8": "4.1.9",
    "archunit": "^2.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "knip": "^6.35.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
